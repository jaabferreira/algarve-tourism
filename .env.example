FH_APP_KEY=your-fareharbor-app-key
FH_USER_KEY=your-fareharbor-user-key
FH_ATLANTIS_SHORTNAME=atlantistours
FH_AY_SHORTNAME=atlantistours

# FareHarbor: numeric id of the hidden "Source Site" custom field configured in the
# FH dashboard (atlantistours account, applied to all items). Used to tag every
# booking with the originating website for downstream channel attribution.
PUBLIC_FH_SOURCE_SITE_CF_ID=

DEPLOY_HOST=your-plesk-server.com
DEPLOY_USER=deploy
DEPLOY_ATLANTIS_PATH=/var/www/atlantistours.pt
DEPLOY_AY_PATH=/var/www/algarveandyou.com

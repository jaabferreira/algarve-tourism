---
import type { Locale } from "@algarve-tourism/shared";
import { LOCALES, t, getLocalePath, optimizeImageUrl, buildBreadcrumbList } from "@algarve-tourism/shared";
import Layout from "../../../../layouts/Layout.astro";
import Header from "@algarve-tourism/shared/components/Header.astro";
import Footer from "@algarve-tourism/shared/components/Footer.astro";
import WhatsAppButton from "@algarve-tourism/shared/components/WhatsAppButton.astro";
import { config } from "../../../../config.js";
import { loadItems } from "../../../../data.js";
import { AIRPORTS, getDestinationsForAirport } from "../../../../transfers.js";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const items = loadItems(locale);

const airportCards = AIRPORTS.map((airport) => {
  const destinations = getDestinationsForAirport(airport);
  const heroPk = destinations[0]?.primaryPk;
  const heroItem = items.find((i) => i.pk === heroPk);
  const heroImg = heroItem?.images?.[0]?.url ?? heroItem?.image_url ?? "";
  return {
    airport,
    name: t(locale, `transfer.airport.${airport}`),
    blurb: t(locale, `transfers.${airport}_blurb`),
    href: getLocalePath(locale, `/tours/transfers/${airport}/`),
    img: heroImg ? optimizeImageUrl(heroImg, 800) : "",
  };
});

const structuredData = [
  buildBreadcrumbList(config, locale, [
    { name: "Home", path: "/" },
    { name: t(locale, "nav.tours"), path: "/tours/" },
    { name: t(locale, "category.transfers"), path: "/tours/transfers/" },
  ]),
];
---

<Layout
  title={t(locale, "transfers.choose_airport_title")}
  description={t(locale, "meta.category.transfers")}
  locale={locale}
  path="/tours/transfers/"
  config={config}
  structuredData={structuredData}
>
  <Header slot="header" config={config} locale={locale} path={`/${locale}/tours/transfers/`} />

  <section class="section container chooser">
    <header class="chooser__intro">
      <h1>{t(locale, "transfers.choose_airport_title")}</h1>
      <p class="chooser__lede">{t(locale, "transfers.choose_airport_blurb")}</p>
    </header>

    <div class="chooser__grid">
      {airportCards.map((card) => (
        <a href={card.href} class="airport-card" data-reveal>
          <div class="airport-card__image">
            {card.img && (
              <img src={card.img} alt={card.name} loading="lazy" width="800" height="520" />
            )}
            <div class="airport-card__scrim">
              <span class="airport-card__eyebrow">{card.airport === "faro" ? "FAO" : "LIS"}</span>
              <h2 class="airport-card__title">{card.name}</h2>
              <p class="airport-card__blurb">{card.blurb}</p>
              <span class="airport-card__cta">{t(locale, "transfers.choose_destination")} &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Footer slot="footer" config={config} locale={locale} />
  <WhatsAppButton phone={config.social.whatsapp} locale={locale} />
</Layout>

<style>
  .chooser {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-16);
  }

  .chooser__intro {
    max-width: 640px;
    margin-bottom: var(--space-10);
  }

  .chooser__lede {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .chooser__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .chooser__grid {
      grid-template-columns: 1fr;
    }
  }

  .airport-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .airport-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .airport-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .airport-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms ease;
  }

  .airport-card:hover .airport-card__image img {
    transform: scale(1.04);
  }

  .airport-card__scrim {
    position: absolute;
    inset: 0;
    padding: var(--space-8) var(--space-6) var(--space-6);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.35) 55%, rgba(0, 0, 0, 0.1) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    color: #fff;
  }

  .airport-card__eyebrow {
    align-self: flex-start;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(6px);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .airport-card__title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: var(--weight-regular);
    font-style: italic;
    line-height: var(--leading-snug);
    color: #fff;
  }

  .airport-card__blurb {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
    line-height: var(--leading-relaxed);
    max-width: 420px;
  }

  .airport-card__cta {
    margin-top: var(--space-2);
    font-size: 11px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: #fff;
  }
</style>

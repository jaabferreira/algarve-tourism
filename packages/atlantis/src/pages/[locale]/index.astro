---
import { getCollection } from "astro:content";
import type { Locale } from "@algarve-tourism/shared";
import { LOCALES, t } from "@algarve-tourism/shared";
import Layout from "../../layouts/Layout.astro";
import Header from "@algarve-tourism/shared/components/Header.astro";
import Footer from "@algarve-tourism/shared/components/Footer.astro";
import HeroSection from "@algarve-tourism/shared/components/HeroSection.astro";
import ProductGrid from "@algarve-tourism/shared/components/ProductGrid.astro";
import ReviewsGrid from "@algarve-tourism/shared/components/ReviewsGrid.astro";
import WhatsAppButton from "@algarve-tourism/shared/components/WhatsAppButton.astro";
import Marquee from "@algarve-tourism/shared/components/Marquee.astro";
import BlogCard from "@algarve-tourism/shared/components/BlogCard.astro";
import TrustBar from "@algarve-tourism/shared/components/TrustBar.astro";
import { config, tourCategories } from "../../config.js";
import { getLocalePath, buildLocalBusiness } from "@algarve-tourism/shared";
import manualReviews from "../../content/reviews/manual.json";
import { loadItems } from "../../data.js";
import { getTrustItems } from "../../lib/trust-items.js";
import { getHomepageVideo } from "../../lib/videos.js";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const path = "/";

const structuredData = buildLocalBusiness(config);

const items = loadItems(locale);
const itemsByPk = new Map(items.map((item) => [item.pk, item]));

const categorizedSections = tourCategories
  .map((cat) => ({
    key: cat.key,
    label: t(locale, `category.${cat.key}` as any),
    items: cat.pks.map((pk) => itemsByPk.get(pk)).filter((item): item is NonNullable<typeof item> => item !== undefined),
  }))
  .filter((section) => section.items.length > 0);
const topReviews = manualReviews.filter((r) => r.rating >= 4).slice(0, 3);

// Speedboat Benagil caves — high-res (2.1MB source)
const heroImage = "https://cdn.filestackcontent.com/resize=width:1920,fit:max/quality=value:85/bT14MOwPTli7XyXt79eR";
const homepageVideo = getHomepageVideo();

let heroTitle = config.tagline;
let heroSubtitle = "";
try {
  const page = await getCollection("pages");
  const homePage = page.find((p) => p.id === `${locale}/homepage` || p.id === `${locale}/homepage.md`);
  if (homePage) {
    heroTitle = homePage.data.title;
    heroSubtitle = homePage.data.description ?? "";
  }
} catch {}

const marqueeText = t(locale, "marquee.atlantis");

const allBlog = await getCollection("blog");
const blogPosts = allBlog
  .filter((post) => post.data.locale === locale)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const PILLAR_SLUG = "benagil-cave-tour-complete-guide";
const pillarExists = allBlog.some(
  (p) => p.data.locale === locale && p.slug.replace(`${p.data.locale}/`, "") === PILLAR_SLUG,
);

const trustItems = getTrustItems(locale);
---

<Layout
  title={heroTitle}
  description={t(locale, "meta.home_atlantis")}
  locale={locale}
  path={path}
  config={config}
  structuredData={structuredData}
  heroImage={heroImage}
>
  <Header slot="header" config={config} locale={locale} path={`/${locale}${path}`} />

  <HeroSection
    config={config}
    locale={locale}
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaText={t(locale, "hero.cta")}
    ctaLink={getLocalePath(locale, "/tours/")}
    image={heroImage}
    videoSrc={homepageVideo?.ambientClip}
  />

  <Marquee text={marqueeText} />

  {categorizedSections.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-label">{t(locale, "home.our_experiences")}</p>
            <h2 class="section-title" set:html={t(locale, "home.popular_tours")} />
          </div>
          <a href={`/${locale}/tours/`} class="see-all">{t(locale, "home.view_all_tours")} &rarr;</a>
        </div>
        <div class="categories-row">
          {categorizedSections.map((section) => (
            <div class="category-column">
              <h3 class="category-title">{section.label}</h3>
              <ProductGrid items={section.items} brand={config.brand} locale={locale} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <TrustBar items={trustItems} />

  {topReviews.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-label">{t(locale, "home.what_people_say")}</p>
            <h2 class="section-title" set:html={t(locale, "home.guest_reviews")} />
          </div>
          <a href={`/${locale}/reviews/`} class="see-all">{t(locale, "home.all_reviews")} &rarr;</a>
        </div>
        <ReviewsGrid reviews={topReviews} brand={config.brand} locale={locale} />
      </div>
    </section>
  )}

  {blogPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-label">{t(locale, "home.blog_label")}</p>
            <h2 class="section-title" set:html={t(locale, "home.blog_title")} />
          </div>
          <div class="section-header__links">
            {pillarExists && (
              <a href={getLocalePath(locale, `/blog/${PILLAR_SLUG}/`)} class="see-all">{t(locale, "blog.start_here_cta")} &rarr;</a>
            )}
            <a href={`/${locale}/blog/`} class="see-all">{t(locale, "home.view_all_posts")} &rarr;</a>
          </div>
        </div>
        <div class="blog-grid">
          {blogPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              slug={post.slug.replace(`${locale}/`, "")}
              image={post.data.image}
              date={post.data.date}
              locale={locale}
              brand={config.brand}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" config={config} locale={locale} />
  <WhatsAppButton phone={config.social.whatsapp} locale={locale} />
</Layout>

<style>
  .section-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .section-title {
    font-family: var(--font-accent);
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
  }
  .section-title em {
    font-style: italic;
    color: var(--color-primary);
  }
  .categories-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
    align-items: start;
  }
  .category-column {
    display: flex;
    flex-direction: column;
  }
  .category-title {
    font-family: var(--font-accent);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    font-style: italic;
  }
  .category-column :global(.product-grid--atlantis) {
    grid-template-columns: 1fr;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  .section-header__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .section-title {
      font-size: var(--text-2xl);
    }
  }
</style>

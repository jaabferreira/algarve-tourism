const c = copy[locale];
const shareUrl = `https://www.${config.domain}${path}`;
---

<Layout
  title="Allgarbe Menu"
  description="Allgarbe restaurant menu."
  locale={locale}
  path="/partners/allgarbe/"
  config={config}
  noindex
>
  <Header slot="header" config={config} locale={locale} path={path} />

  <section class="menu-hero">
    <div class="menu-hero__inner container">
      <h1 class="menu-hero__title">Allgarbe</h1>
      <p class="menu-hero__subtitle">{c.menuSubtitle}</p>
      <img
        src={menuImage}
        alt="Allgarbe restaurant menu"
        class="menu-hero__image"
        decoding="async"
        fetchpriority="high"
        data-gallery-index="0"
      />
      <p class="menu-hero__hint">{c.tapHint}</p>
    </div>
  </section>

  <div class="lightbox" id="menu-lightbox" aria-hidden="true">
    <button class="lightbox__close" aria-label={t(locale, "a11y.close")}>&times;</button>
    <div class="lightbox__content">
      <img class="lightbox__image" src={menuImage} alt="Allgarbe restaurant menu" />
    </div>
  </div>

  <section class="location">
    <div class="container">
      <a
        class="location-card"
        href="https://maps.app.goo.gl/TK9uuGNdvnaAQfZX7"
        target="_blank"
        rel="noopener"
        data-track="open_maps"
      >
        <span class="location-card__pin" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <span class="location-card__text">
          <span class="location-card__name">Allgarbe</span>
          <span class="location-card__address">R. da Hortinha 35, Portimão</span>
        </span>
        <span class="location-card__cta">
          {t(locale, "product.location_directions")}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </span>
      </a>
    </div>
  </section>

  <section class="discount-hero" aria-labelledby="discount-title">
    <div class="container discount-hero__inner">
      <p class="discount-hero__eyebrow">{c.discountEyebrow}</p>
      <h2 id="discount-title" class="discount-hero__title" set:html={c.discountTitle} />
      <p class="discount-hero__sub">{c.discountSub}</p>

      <button
        type="button"
        class="discount-code"
        data-copy-code
        data-code={discountCode}
        data-copied-label={c.discountCopied}
        aria-label={`${c.discountCodeLabel}: ${discountCode}. ${c.discountCopyHint}`}
      >
        <span class="discount-code__label">{c.discountCodeLabel}</span>
        <span class="discount-code__row">
          <span class="discount-code__value">{discountCode}</span>
          <span class="discount-code__icon" aria-hidden="true">
            <svg class="discount-code__icon--copy" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="discount-code__icon--check" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </span>
        <span class="discount-code__hint" data-copy-hint>{c.discountCopyHint}</span>
      </button>

      <a href="#tours" class="discount-hero__cta" data-track="discount_see_tours">
        {c.discountCTA}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
    </div>
  </section>

  {items.length > 0 && (
    <section id="tours" class="section section--tours">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-label">{c.exploreLabel}</p>
            <h2 class="section-title" set:html={c.exploreTitle} />
            <p class="section-sub">{c.exploreSub}</p>
          </div>
          <a href={toursHref} class="see-all">{c.viewAll} &rarr;</a>
        </div>
        <ProductGrid items={items} brand={config.brand} locale={locale} />
      </div>
    </section>
  )}

  <section class="social-split">
    <div class="container">
      <div class="social-split__grid">
        <div class="social-split__card">
          <div class="social-split__badges" aria-hidden="true">
            <div class="social-split__badge social-split__badge--ta">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="#00AF87">
                <path d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 0 0 4.04 10.43 5.976 5.976 0 0 0 4.075-1.6L12 19.705l1.922-2.09a5.976 5.976 0 0 0 4.072 1.598 6 6 0 0 0 6.003-5.998 5.974 5.974 0 0 0-1.962-4.435L24 6.648h-4.35a13.573 13.573 0 0 0-7.644-2.353zM6.003 8.912a4.088 4.088 0 1 1 0 8.176 4.088 4.088 0 0 1 0-8.176zm11.991 0a4.088 4.088 0 1 1 .001 8.177 4.088 4.088 0 0 1 0-8.177zM6.003 10.85a2.15 2.15 0 1 0 .001 4.301 2.15 2.15 0 0 0 0-4.301zm11.991 0a2.15 2.15 0 1 0 .001 4.301 2.15 2.15 0 0 0 0-4.301z"/>
              </svg>
            </div>
            <div class="social-split__badge social-split__badge--google">
              <svg viewBox="0 0 48 48" width="24" height="24">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
            </div>
          </div>
          <h2 class="social-split__title" set:html={t(locale, "reviews.leave_title")} />
          <p class="social-split__sub">{t(locale, "reviews.leave_subtitle")}</p>
          <div class="social-split__buttons">
            <a
              href="https://www.tripadvisor.com/Attraction_Review-g189120-d19733159-Reviews-ATLANTIS_TOURS_Mare_Nostrum-Portimao_Faro_District_Algarve.html"
              target="_blank"
              rel="noopener noreferrer"
              class="social-split__btn social-split__btn--ta"
              data-track="review_click"
              data-platform="tripadvisor"
            >
              {t(locale, "reviews.leave_tripadvisor")}
            </a>
            <a
              href="https://g.page/r/CXFx9AoFKCpREBM/review"
              target="_blank"
              rel="noopener noreferrer"
              class="social-split__btn social-split__btn--google"
              data-track="review_click"
              data-platform="google"
            >
              {t(locale, "reviews.leave_google")}
            </a>
          </div>
        </div>

        <div class="social-split__card">
          <div class="social-split__badges" aria-hidden="true">
            <div class="social-split__badge social-split__badge--ig">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </div>
          </div>
          <h2 class="social-split__title" set:html={c.igTitle} />
          <p class="social-split__sub">{c.igSub}</p>
          <div class="social-split__buttons">
            <a
              href={config.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="social-split__btn social-split__btn--ig"
              data-track="instagram_click"
            >
              {c.igBtn}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="share">
    <div class="share__inner container">
      <h2 class="share__title">{c.shareTitle}</h2>
      <p class="share__sub">{c.shareSub}</p>
      <div class="share__buttons">
        <a
          href={`https://wa.me/?text=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener"
          class="share__btn share__btn--primary"
          data-track="share_whatsapp"
        >
          {c.shareBtn}
        </a>
        <button
          type="button"
          class="share__btn"
          data-share-copy
          data-url={shareUrl}
          data-copied-label={c.shareCopied}
        >
          {c.shareCopy}
        </button>
      </div>
    </div>
  </section>

  {blogPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-label">{c.blogLabel}</p>
            <h2 class="section-title" set:html={c.blogTitle} />
          </div>
          <a href={`/${locale}/blog/`} class="see-all">{c.viewBlog} &rarr;</a>
        </div>
        <div class="blog-grid-compact">
          {blogPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              slug={post.slug.replace(`${locale}/`, "")}
              image={post.data.image}
              date={post.data.date}
              locale={locale}
              brand={config.brand}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" config={config} locale={locale} />
  <WhatsAppButton phone={config.social.whatsapp} locale={locale} />
</Layout>

<script>
  // GA4 event helper — all events land in GA4 under the 'allgarbe_menu' context
  function track(event: string, params: Record<string, unknown> = {}) {
    const w = window as any;
    if (typeof w.gtag === "function") {
      w.gtag("event", event, { page_context: "allgarbe_menu", ...params });
    }
  }

  // Discount: tap-to-copy promo code with GA event + visual confirmation
  document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((btn) => {
    const hint = btn.querySelector<HTMLElement>("[data-copy-hint]");
    const originalHint = hint?.textContent || "";
    const copiedLabel = btn.dataset.copiedLabel || "Copied";
    const code = btn.dataset.code || "";
    let timer: number | undefined;
    btn.addEventListener("click", async () => {
      track("copy_promo_code", { code });
      try {
        await navigator.clipboard.writeText(code);
        btn.classList.add("is-copied");
        if (hint) hint.textContent = copiedLabel;
        if (timer) window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.classList.remove("is-copied");
          if (hint) hint.textContent = originalHint;
        }, 2000);
      } catch {
        // Ignore clipboard failures (e.g. insecure context)
      }
    });
  });

  // Share: copy-to-clipboard with GA event
  document.querySelectorAll<HTMLButtonElement>("[data-share-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = btn.dataset.url || "";
      const copied = btn.dataset.copiedLabel || "Copied";
      const original = btn.textContent || "";
      track("share_copy");
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = copied;
        setTimeout(() => { btn.textContent = original; }, 1800);
      } catch {
        // Ignore clipboard failures (e.g. insecure context)
      }
    });
  });

  // Generic tracking via [data-track] attribute — passes data-platform if present
  document.querySelectorAll<HTMLElement>("[data-track]").forEach((el) => {
    el.addEventListener("click", () => {
      const event = el.dataset.track || "click";
      const params: Record<string, unknown> = {};
      if (el.dataset.platform) params.platform = el.dataset.platform;
      track(event, params);
    });
  });

  // Tour card clicks
  document.querySelectorAll<HTMLAnchorElement>(".product-grid a.card").forEach((link) => {
    link.addEventListener("click", () => {
      const title = link.querySelector(".card__title")?.textContent?.trim() || "unknown";
      track("tour_click", { tour: title });
    });
  });

  // Blog card clicks
  document.querySelectorAll<HTMLAnchorElement>(".blog-grid-compact a.blog-card").forEach((link) => {
    link.addEventListener("click", () => {
      const title = link.querySelector(".blog-card__title")?.textContent?.trim() || "unknown";
      track("blog_click", { post: title });
    });
  });

  // Floating WhatsApp button (shared component, selector matches its class)
  document.querySelectorAll<HTMLAnchorElement>("a.whatsapp-btn").forEach((link) => {
    link.addEventListener("click", () => track("whatsapp_float_click"));
  });

  // Lightbox — matches ProductHero pattern
  document.addEventListener("DOMContentLoaded", () => {
    const lightbox = document.getElementById("menu-lightbox");
    if (!lightbox) return;
    const closeBtn = lightbox.querySelector(".lightbox__close");
    const content = lightbox.querySelector(".lightbox__content");

    function show() {
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      track("menu_zoom");
    }
    function hide() {
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    document.querySelectorAll("[data-gallery-index]").forEach((el) => {
      el.addEventListener("click", () => show());
    });
    closeBtn?.addEventListener("click", hide);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === content) hide();
    });
    document.addEventListener("keydown", (e) => {
      if (lightbox.getAttribute("aria-hidden") !== "false") return;
      if (e.key === "Escape") hide();
    });
  });
</script>

<style>
  .menu-hero {
    padding: calc(var(--header-height) + var(--space-8)) 0 var(--space-10);
  }
  .menu-hero__inner {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .menu-hero__title {
    font-family: var(--font-accent), Georgia, serif;
    font-size: clamp(40px, 7vw, 56px);
    font-weight: var(--weight-regular);
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
    font-style: italic;
  }
  .menu-hero__subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin: 0 0 var(--space-4);
  }
  .menu-hero__image {
    width: 100%;
    max-width: 560px;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: var(--radius-card, 12px);

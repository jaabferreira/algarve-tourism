---
import type { Locale, NormalizedItem } from "@algarve-tourism/shared";
import { LOCALES, t, buildBreadcrumbList, parseDescription, formatPrice, buildVideoObject } from "@algarve-tourism/shared";
import Layout from "../../../layouts/Layout.astro";
import Header from "@algarve-tourism/shared/components/Header.astro";
import Footer from "@algarve-tourism/shared/components/Footer.astro";
import ProductHero from "@algarve-tourism/shared/components/ProductHero.astro";
import BookingWidget from "@algarve-tourism/shared/components/BookingWidget.astro";
import ProductGrid from "@algarve-tourism/shared/components/ProductGrid.astro";
import WhatsAppButton from "@algarve-tourism/shared/components/WhatsAppButton.astro";
import MeetingPointMap from "@algarve-tourism/shared/components/MeetingPointMap.astro";
import TrustBar from "@algarve-tourism/shared/components/TrustBar.astro";
import ReviewsGrid from "@algarve-tourism/shared/components/ReviewsGrid.astro";
import VideoLightbox from "@algarve-tourism/shared/components/VideoLightbox.astro";
import { config } from "../../../config.js";
import { loadItems, getVariants } from "../../../data.js";
import manualReviews from "../../../content/reviews/manual.json";
import { getTrustItems } from "../../../lib/trust-items.js";
import { getTourVideo } from "../../../lib/videos.js";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => {
    const items = loadItems(locale);
    return items.map((item) => ({
      params: { locale, slug: item.slug },
      props: { item, locale },
    }));
  });
}

const { item } = Astro.props as { item: NormalizedItem };
const locale = Astro.params.locale as Locale;

const allItems = loadItems(locale);
const relatedItems = allItems.filter((i) => i.pk !== item.pk).slice(0, 3);

const parsed = parseDescription(item.description_html);

const productData = {
  "@context": "https://schema.org",
  "@type": ["Product", "TouristTrip"],
  name: item.name,
  description: parsed.description?.slice(0, 160) ?? item.description_text,
  image: item.images.map((img) => img.url),
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: (item.price_from_including_tax / 100).toFixed(2),
    availability: "https://schema.org/InStock",
  },
  ...(item.location && {
    touristType: "Leisure",
    itinerary: {
      "@type": "Place",
      geo: {
        "@type": "GeoCoordinates",
        latitude: item.location.latitude,
        longitude: item.location.longitude,
      },
    },
  }),
};

const tourReviews = manualReviews.filter(
  (r) => r.fareharborItemPk === item.pk && r.verifiedBooking && r.permissionToPublish
);

const visibleReviews = tourReviews.length >= 2
  ? tourReviews.slice(0, 3)
  : manualReviews.filter((r) => r.rating >= 4 && r.permissionToPublish).slice(0, 3);

const trustItems = getTrustItems(locale);
const tourVideo = getTourVideo(item.pk);

if (tourReviews.length > 0) {
  const avgRating = (tourReviews.reduce((sum, r) => sum + r.rating, 0) / tourReviews.length).toFixed(1);
  productData.aggregateRating = {
    "@type": "AggregateRating",
    ratingValue: avgRating,
    bestRating: "5",
    ratingCount: tourReviews.length,
  };
  productData.review = tourReviews.map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.author },
    datePublished: r.date,
    reviewRating: {
      "@type": "Rating",
      ratingValue: r.rating,
      bestRating: "5",
    },
    reviewBody: r.text,
  }));
}

const breadcrumbData = buildBreadcrumbList(config, locale, [
  { name: "Home", path: "/" },
  { name: t(locale, "nav.tours"), path: "/tours/" },
  { name: item.name, path: `/tours/${item.slug}/` },
]);

const structuredData: object[] = [productData, breadcrumbData];
if (tourVideo?.youtubeId && tourVideo.youtubeMetadata) {
  structuredData.push(
    buildVideoObject({
      youtubeId: tourVideo.youtubeId,
      ...tourVideo.youtubeMetadata,
    }),
  );
}

const SOURCE_SITE_CF_ID = import.meta.env.PUBLIC_FH_SOURCE_SITE_CF_ID;
const fhUrl =
  `https://fareharbor.com/embeds/book/${config.fh.shortname}/items/${item.pk}/` +
  `?full-items=yes&cf-${SOURCE_SITE_CF_ID}=atlantis-tours`;

const localePaths: Partial<Record<Locale, string>> = {};
for (const loc of config.locales as Locale[]) {
  if (loc === locale) {
    localePaths[loc] = `/${loc}/tours/${item.slug}/`;
    continue;
  }
  const localeItems = loadItems(loc);
  const match = localeItems.find((i) => i.pk === item.pk);
  localePaths[loc] = match ? `/${loc}/tours/${match.slug}/` : `/${loc}/tours/`;
}
---

<Layout
  title={item.name}
  description={(parsed.description ?? item.description_text).slice(0, 160)}
  image={item.image_url}
  locale={locale}
  path={`/tours/${item.slug}/`}
  config={config}
  structuredData={structuredData}
  heroImage={item.images[0]?.url}
>
  <Header slot="header" config={config} locale={locale} path={`/${locale}/tours/${item.slug}/`} localePaths={localePaths} />

  <div class="container product-detail">
    <ProductHero
      item={item}
      locale={locale}
      brand={config.brand}
      videoSrc={tourVideo?.ambientClip}
    />

    <div class="product-detail__content">
      <div class="product-detail__body">
        {item.description_bullets.length > 0 && (
          <section>
            <h2>{t(locale, "product.highlights")}</h2>
            <ul class="product-detail__bullets">
              {item.description_bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </section>
        )}

        {(parsed.duration || parsed.accessibility) && (
          <div class="product-detail__info-row">
            {parsed.duration && (
              <span class="product-detail__info-item">
                <strong>{t(locale, "product.duration")}:</strong> {parsed.duration}
              </span>
            )}
            {parsed.accessibility && (
              <span class="product-detail__info-item product-detail__info-item--access">
                {parsed.accessibility}
              </span>
            )}
          </div>
        )}

        {parsed.description && (
          <section>
            <div class="product-detail__description">
              {parsed.description.split(/\n\n+/).filter(Boolean).map((para) => (
                <p>{para.replace(/\n/g, " ").trim()}</p>
              ))}
            </div>
          </section>
        )}

        {tourVideo?.youtubeId && (
          <section class="product-detail__video">
            <VideoLightbox
              youtubeId={tourVideo.youtubeId}
              posterImage={item.images[0]?.url}
              label={t(locale, "product.watch_experience")}
            />
          </section>
        )}

        {parsed.itinerary && parsed.itinerary.length > 0 && (
          <section>
            <h3>{t(locale, "product.itinerary")}</h3>
            <ol class="product-detail__itinerary">
              {parsed.itinerary.map((stop) => <li>{stop}</li>)}
            </ol>
          </section>
        )}

        {parsed.restrictions && parsed.restrictions.length > 0 && (
          <section>
            <h3>{t(locale, "product.restrictions")}</h3>
            <ul class="product-detail__list">
              {parsed.restrictions.map((r) => <li>{r}</li>)}
            </ul>
          </section>
        )}

        {parsed.extras && parsed.extras.length > 0 && (
          <section>
            <h3>{t(locale, "product.extras")}</h3>
            <ul class="product-detail__list">
              {parsed.extras.map((line) => <li>{line}</li>)}
            </ul>
          </section>
        )}

        {parsed.disclaimers && (
          <p class="product-detail__disclaimer">{parsed.disclaimers}</p>
        )}

        {item.location && (
          <MeetingPointMap
            latitude={item.location.latitude}
            longitude={item.location.longitude}
            address={item.location.address}
            city={item.location.city}
            locale={locale}
          />
        )}

        {item.cancellation_policy_html && (
          <section>
            <h3>{t(locale, "product.cancellation")}</h3>
            <div set:html={item.cancellation_policy_html} />
          </section>
        )}
      </div>

      <aside class="product-detail__sidebar">
        <BookingWidget
          item={item}
          companyShortname={config.fh.shortname}
          locale={locale}
          siteSource="atlantis-tours"
          variants={getVariants(item.pk, locale)}
        />
      </aside>
    </div>

    {visibleReviews.length > 0 && (
      <section class="section product-detail__reviews">
        <div class="section-header">
          <div>
            <p class="section-label">{t(locale, "home.what_people_say")}</p>
            <h2 class="section-title" set:html={t(locale, "home.guest_reviews")} />
          </div>
          <a href={`/${locale}/reviews/`} class="see-all">{t(locale, "home.all_reviews")} &rarr;</a>
        </div>
        <ReviewsGrid reviews={visibleReviews} brand={config.brand} locale={locale} />
      </section>
    )}

    {relatedItems.length > 0 && (
      <section class="section">
        <h2>{t(locale, "product.related")}</h2>
        <ProductGrid items={relatedItems} brand={config.brand} locale={locale} />
      </section>
    )}
  </div>

  <TrustBar items={trustItems} />

  <Footer slot="footer" config={config} locale={locale} />
  <WhatsAppButton phone={config.social.whatsapp} locale={locale} />

  <div class="mobile-booking-bar">
    <div class="mobile-booking-bar__price">
      {t(locale, "product.from")} {formatPrice(item.price_from_including_tax)}
    </div>
    <div class="mobile-booking-bar__actions">
      {config.social.phone && (
        <a
          href={`tel:${config.social.phone.replace(/[^+0-9]/g, "")}`}
          class="mobile-booking-bar__call"
          aria-label={`Call ${config.social.phone}`}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      )}
      <a href={fhUrl} class="mobile-booking-bar__cta">
        {t(locale, "product.book_now")}
      </a>
    </div>
  </div>
</Layout>

<style>
  .product-detail {
    padding-bottom: var(--space-16);
  }

  .product-detail__reviews .section-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .product-detail__reviews .section-title {
    font-family: var(--font-accent);
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
  }
  .product-detail__reviews .section-title em {
    font-style: italic;
    color: var(--color-primary);
  }
  @media (max-width: 768px) {
    .product-detail__reviews .section-title {
      font-size: var(--text-2xl);
    }
  }

  .product-detail__content {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-10);
    margin-top: var(--space-10);
  }

  .product-detail__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .product-detail__body section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .product-detail__bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .product-detail__bullets li::before {
    content: "\2713 ";
    color: var(--color-primary);
    font-weight: var(--weight-bold);
  }

  .product-detail__description {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-body);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .product-detail__info-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-detail__info-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .product-detail__info-item strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .product-detail__itinerary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-1) var(--space-6);
    counter-reset: itinerary;
    padding: 0;
    margin: 0;
  }

  .product-detail__itinerary li {
    counter-increment: itinerary;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-body);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .product-detail__itinerary li::before {
    content: counter(itinerary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    flex-shrink: 0;
  }

  .product-detail__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-5);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-body);
  }

  .product-detail__disclaimer {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--color-border);
  }

  @media (max-width: 480px) {
    .product-detail__itinerary {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .product-detail__content {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile booking bar */
  .mobile-booking-bar {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-booking-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 91;
      background: rgba(247, 250, 251, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--color-border);
      padding: var(--space-3) var(--space-5);
      padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
    }

    .mobile-booking-bar__price {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: var(--weight-bold);
      color: var(--color-text);
    }

    .mobile-booking-bar__actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-shrink: 0;
    }

    .mobile-booking-bar__call {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 8px;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
      color: var(--color-primary);
      text-decoration: none;
      flex-shrink: 0;
    }

    .mobile-booking-bar__cta {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      padding: var(--space-2) var(--space-5);
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
      color: #fff;
      font-size: 13px;
      font-weight: var(--weight-semibold);
      border-radius: 8px;
      text-decoration: none;
      white-space: nowrap;
    }

    :global(body) {
      padding-bottom: calc(60px + env(safe-area-inset-bottom));
      --whatsapp-bottom: calc(var(--space-6) + 60px + env(safe-area-inset-bottom));
    }
  }
</style>

---
import SEO from '../components/SEO.astro';
import CookieConsent from '../components/CookieConsent.astro';
import type { BrandConfig, Locale } from '../types';
import { optimizeImageUrl, optimizeImageSrcset } from '../lib/images';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  locale: string;
  path: string;
  config: BrandConfig;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  publishedDate?: string;
  modifiedDate?: string;
  articleSection?: string;
  articleTags?: string[];
  noindex?: boolean;
  alternateUrls?: { locale: Locale; href: string }[];
  heroImage?: string;
  preloadFonts?: string[];
}

const { title, description, image, type = 'website', locale, path, config, structuredData, publishedDate, modifiedDate, articleSection, articleTags, noindex, alternateUrls, heroImage, preloadFonts } = Astro.props;

const heroPreloadSrc = heroImage ? optimizeImageUrl(heroImage, 1080, 75) : undefined;
const heroPreloadSrcset = heroImage ? optimizeImageSrcset(heroImage, [750, 1080, 1440, 1920]) : undefined;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="dns-prefetch" href="https://cdn.filestackcontent.com" />
  <link rel="preconnect" href="https://cdn.filestackcontent.com" />
  <link rel="preconnect" href="https://fareharbor.com" />
  {preloadFonts?.map((href) => (
    <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
  ))}
  {heroPreloadSrc && (
    <link
      rel="preload"
      as="image"
      href={heroPreloadSrc}
      imagesrcset={heroPreloadSrcset}
      imagesizes="100vw"
      fetchpriority="high"
    />
  )}
  <SEO
    title={title}
    description={description}
    image={image}
    type={type}
    locale={locale}
    path={path}
    config={config}
    structuredData={structuredData}
    publishedDate={publishedDate}
    modifiedDate={modifiedDate}
    articleSection={articleSection}
    articleTags={articleTags}
    noindex={noindex}
    alternateUrls={alternateUrls}
  />
  {config.analytics.gtag && (
    <>
      {/* Consent Mode v2 — must run before gtag('config'). Non-essential
          storage defaults to denied; a valid `aty_consent` cookie upgrades it.
          The 'v1|' prefix MUST match CONSENT_VERSION in lib/consent.ts. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
        gtag('set', 'ads_data_redaction', true);
        gtag('set', 'url_passthrough', true);
        try {
          var fhMatch = document.cookie.match(/(?:^|; )aty_consent=([^;]*)/);
          if (fhMatch) {
            var fhConsent = decodeURIComponent(fhMatch[1]);
            if (fhConsent.indexOf('v1|') === 0) {
              var fhA = fhConsent.indexOf('analytics=1') !== -1 ? 'granted' : 'denied';
              var fhM = fhConsent.indexOf('marketing=1') !== -1 ? 'granted' : 'denied';
              gtag('consent', 'update', {
                analytics_storage: fhA,
                ad_storage: fhM,
                ad_user_data: fhM,
                ad_personalization: fhM
              });
              document.documentElement.setAttribute('data-consent', 'set');
            }
          }
        } catch (e) {}
      </script>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${config.analytics.gtag}`}></script>
      <script define:vars={{ gtagId: config.analytics.gtag }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gtagId);
      </script>
    </>
  )}
  {config.analytics.gtm && (
    <>
      {/* Google Tag Manager (Atlantis Tours only — brand-gated via config.analytics.gtm).
          Placed after the Consent Mode v2 default above so GTM-fired tags inherit consent.
          The container is currently EMPTY. If FareHarbor later adds a GA4 tag for
          G-YE21ZWJNY7 inside GTM, remove the direct gtag('config') above to avoid
          double-counting the same Measurement ID. */}
      <script define:vars={{ gtmId: config.analytics.gtm }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    </>
  )}
</head>
<body>
  {config.analytics.gtm && (
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${config.analytics.gtm}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  )}
  <slot name="header" />
  <main>
    <slot />
  </main>
  <slot name="footer" />
  {config.analytics.gtag && (
    <script>
      import { onCLS, onLCP, onINP, onFCP, onTTFB } from 'web-vitals/attribution';

      const w = window as any;
      w.dataLayer = w.dataLayer || [];

      // Pushing an Arguments object (via function call) is what gtag.js picks
      // up from the dataLayer queue — plain-array pushes get ignored.
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        w.dataLayer.push(arguments);
      }

      function report(metric: any) {
        const a = metric.attribution || {};
        // CLS is a unitless score; scale ×1000 so GA4 stores it as an integer.
        const isCls = metric.name === 'CLS';
        const scaled = (v: number) => Math.round(isCls ? v * 1000 : v);

        gtag('event', 'web_vitals', {
          metric_id: metric.id,
          metric_name: metric.name,
          metric_value: scaled(metric.value),
          metric_delta: scaled(metric.delta),
          metric_rating: metric.rating,
          nav_type: metric.navigationType,
          // Attribution fields — one is populated per metric type.
          cls_target: a.largestShiftTarget || '',
          cls_source: a.largestShiftSource?.node?.nodeName || '',
          lcp_element: a.element || '',
          lcp_url: a.url || '',
          inp_target: a.interactionTarget || '',
          inp_type: a.interactionType || '',
          page_path: location.pathname,
        });

        if ((w as any).__webVitalsDebug) {
          console.log('[web-vitals]', metric.name, scaled(metric.value), a);
        }
      }

      onCLS(report);
      onLCP(report);
      onINP(report);
      onFCP(report);
      onTTFB(report);
    </script>
  )}
  <script>
    // Defer FareHarbor's autolightframe bundle (~1.3 MB) until the visitor
    // actually engages. A capture-phase click handler intercepts FH booking
    // links so a first-interaction click (e.g. header Book Now on a fresh
    // load) still opens the lightframe instead of navigating away while the
    // FH script is mid-flight.
    (() => {
      let loadInitiated = false;
      const FH_LINK_SELECTOR = 'a[href*="fareharbor.com/embeds/book"]';
      const syntheticClicks = new WeakSet();

      const load = () => {
        if (loadInitiated) return;
        loadInitiated = true;
        const s = document.createElement('script');
        s.src = 'https://fareharbor.com/embeds/api/v1/?autolightframe=yes';
        s.async = true;
        document.body.appendChild(s);
      };

      const fhReady = () =>
        typeof (window as any).FH?.open === 'function';

      window.addEventListener(
        'click',
        (e) => {
          const target = e.target as Element | null;
          const link = target?.closest(FH_LINK_SELECTOR) as HTMLAnchorElement | null;
          if (!link) return;
          if (syntheticClicks.has(link)) {
            syntheticClicks.delete(link);
            return; // re-dispatched click: let FH's delegated handler take over
          }
          if (fhReady()) return; // FH bound — autolightframe will intercept
          e.preventDefault();
          e.stopPropagation();
          load();
          const start = Date.now();
          const tryClick = () => {
            if (fhReady()) {
              syntheticClicks.add(link);
              link.click();
              return;
            }
            if (Date.now() - start > 5000) {
              window.location.href = link.href; // give up — fall back to navigation
              return;
            }
            setTimeout(tryClick, 50);
          };
          tryClick();
        },
        true,
      );

      const events = ['pointerdown', 'pointermove', 'touchstart', 'scroll', 'keydown'];
      events.forEach((e) => addEventListener(e, load, { once: true, passive: true }));
      // Fallback for fully-idle users — pushed past the CLS-sensitive window.
      // The 5s default was firing during first-impression and any FH-induced
      // shift was being attributed to CLS (visible in GA4 web_vitals.cls_target).
      setTimeout(load, 30000);
    })();
  </script>
  {config.analytics.gtag && <CookieConsent config={config} locale={locale as Locale} />}
</body>
</html>

<style is:global>
  @import "@algarve-tourism/shared/styles/tokens.css";
  @import "@algarve-tourism/shared/styles/base.css";
  @import "@algarve-tourism/shared/styles/utilities.css";
</style>

<script>
  // Scroll reveal — fade elements in as they enter the viewport.
  // Defensive race-fix: after kicking off the IntersectionObserver, we also do
  // an rAF pass that manually reveals any element whose bounding rect already
  // overlaps the viewport. This avoids a race where the observer's first
  // callback fires with a wrong intersection ratio because image/font loads
  // are still shifting layout — without this, elements above the fold can
  // get stuck at opacity:0 until the user triggers a reflow (e.g. by zooming).
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reveal = (el: HTMLElement) => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
    elements.forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      observer.observe(el);
    });
    // After first paint, reveal anything already in viewport — bypasses the
    // observer race on initial layout.
    requestAnimationFrame(() => {
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      elements.forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < viewportHeight && rect.bottom > 0) {
          reveal(el);
          observer.unobserve(el);
        }
      });
    });
  }
</script>
